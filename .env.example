# Copiá este archivo como .env y completá tus claves. El .env no se sube al repo.

# Proveedor a usar: openai o anthropic
LLM_PROVIDER=openai

# Solo hace falta la clave del proveedor que uses
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Opcionales: modelo de cada proveedor (si se dejan vacíos se usan estos valores)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-opus-5-5
