# Plantilla de variables de entorno: copiar como .env y completar las claves. El .env no se sube al repo.

# Proveedor a usar: openai o anthropic
LLM_PROVIDER=openai

# Solo hace falta la clave del proveedor elegido
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Opcionales: modelo de cada proveedor (si se dejan vacíos se usan estos valores)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5
